{
  "name": "@suzhou-numerals/cli",
  "version": "0.1.0",
  "description": "Draw Suzhou numerals from the command line: SVG, PNG, JPEG or WebP",
  "keywords": [
    "chinese",
    "cli",
    "decimal",
    "hangzhou-numerals",
    "huama",
    "number",
    "numerals",
    "png",
    "suzhou",
    "suzhou-numerals",
    "svg"
  ],
  "homepage": "https://karlnorling.github.io/suzhou-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/suzhou-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/suzhou-numerals.git",
    "directory": "packages/@suzhou-numerals/cli"
  },
  "bin": {
    "suzhou": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@suzhou-numerals/core": "workspace:^",
    "@suzhou-numerals/raster": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
